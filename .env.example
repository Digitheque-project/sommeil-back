# ─────────────────────────────────────────────────────────────────────────
# Configuration du service sommeil-back
#
# IMPORTANT : pour les URLs de services externes, renseignez UNIQUEMENT la
# base URL (sans préfixe ni suffixe). Le code ajoute automatiquement les
# préfixes de chemin (ex. /sommeil/api pour ce service, /prescriptions/medicale
# pour le service prescriptions).
#
# Laissez une variable vide pour utiliser la valeur par défaut définie dans
# le code.
# ─────────────────────────────────────────────────────────────────────────

# Base URL du service consultation externe (sans préfixe ni suffixe).
# Par défaut : http://localhost:3001
CONSULTATION_EXTERNE_URL=

# Token optionnel pour l'authentification auprès du service consultation externe.
CONSULTATION_EXTERNE_TOKEN=

# Base URL du service des prescriptions (sans préfixe ni suffixe).
# Le code ajoute automatiquement /prescriptions/medicale.
# Par défaut : https://prescriptionback-production.up.railway.app
PRESCRIPTIONS_URL=

# Optionnel : base URL du service des prescriptions de polysomnographie
# (sans préfixe ni suffixe). Le code ajoute automatiquement
# /prescriptions/polysomnographie.
# Vide = dérivée de PRESCRIPTIONS_URL.
POLYSOMNOGRAPHIE_URL=

# Préfixe global de l'API. La documentation swagger est exposée sur
# <baseUrl>/<API_PREFIX>/docs.
# Par défaut : sommeil/api
API_PREFIX=

# Port d'écoute du service.
# Par défaut : 8888
PORT=
