# Passerelle unique du CHU : consultation externe, prescriptions, accueil,
# upload, notification et registre des services passent tous par elle.
GATEWAY_URL=
# Secret commun du CHU (signature des jetons de service).
JWT_SECRET=
# Base de données (Supabase, schéma sommeil).
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=sommeil
# Facultatif : le CHU est lu dans le jeton de l'utilisateur ; CHU_ID ne sert
# que de repli pour les appels sans utilisateur.
CHU_ID=
# Facultatif : identifiant du service Centre de Sommeil (sinon résolu par nom).
SLEEP_SERVICE_ID=
SLEEP_SERVICE_NAME=
