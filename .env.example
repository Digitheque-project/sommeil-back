# ─────────────────────────────────────────────────────────────────────────
# Configuration du service sommeil-back
#
# IMPORTANT : pour les URLs de services externes, renseignez UNIQUEMENT la
# base URL (sans préfixe ni suffixe). Le code ajoute automatiquement les
# préfixes de chemin (ex. /sommeil/api pour ce service, /prescriptions/medicale
# pour le service prescriptions).
#
# Laissez une variable vide pour utiliser la valeur par défaut définie dans
# le code.
# ─────────────────────────────────────────────────────────────────────────

# Configuration du service consultation externe (base URL uniquement — le
# préfixe de chemin de ses contrôleurs est ajouté par le code, voir
# CONSULTATION_EXTERNE_API_PREFIX).
CONSULTATION_EXTERNE_URL=http://localhost:3001
CONSULTATION_EXTERNE_TOKEN=
# Préfixe de chemin du service consultation externe. Par défaut :
# consultation/api (c'est son `setGlobalPrefix`).
# CONSULTATION_EXTERNE_API_PREFIX=

# Registre central des services du CHU (annuaire), utilisé pour peupler le
# sélecteur de services lors d'une demande d'hospitalisation. Si vide, une
# liste de repli codée en dur est utilisée à la place.
# Base URL uniquement : le code appelle GET <base>/services. Le swagger du
# registre est publié sous <base>/services/api/docs, mais /services/api n'est
# PAS un préfixe de route — ne pas l'inclure ici.
SERVICES_URL=https://service-service-8cgb.onrender.com

# Établissement du Centre de Sommeil. Les prescriptions remontées sont
# filtrées sur ce CHU, qui sert aussi à retrouver l'identifiant du service
# dans l'annuaire.
CHU_ID=1e5bbbb7-fa10-4d59-8848-2d0ce96a9394

# Identifiant du service Centre de Sommeil, destinataire des prescriptions
# (`serviceIdDest` côté service prescriptions). Laissé vide, il est résolu à
# la volée via GET <PRESCRIPTIONS_URL>/services?chuId=<CHU_ID> en retenant le
# service dont le nom contient SLEEP_SERVICE_NAME (« sommeil » par défaut).
# Le renseigner évite cet appel supplémentaire au démarrage.
SLEEP_SERVICE_ID=
SLEEP_SERVICE_NAME=

# Configuration du service prescriptions (base URL uniquement, voir note
# ci-dessus — le code ajoute lui-même /prescriptions/medicale et
# /prescriptions/polysomnographie). Ne PAS inclure ces suffixes ici, sinon
# ils seront dupliqués dans l'URL finale.
PRESCRIPTIONS_URL=https://prescriptionback-production.up.railway.app
POLYSOMNOGRAPHIE_URL=

# Service upload mutualisé du CHU (photos des comptes rendus).
UPLOAD_URL=https://service-upload-u5z9.onrender.com

# Service accueil : source de vérité de l'identité patient (nom, prénom). Les
# prescriptions ne transportent qu'un `patientId` ; sans ce service, les écrans
# affichent l'identifiant à la place du nom. Base URL uniquement — le code
# appelle GET <base>/accueil/patients/<id>?chuId=<CHU_ID>.
ACCUEIL_URL=https://acceuil-back.onrender.com

# Configuration de la base de données Render PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# Préfixe global de l'API. La documentation swagger est exposée sur
# <baseUrl>/<API_PREFIX>/docs.
# Par défaut : sommeil/api
# API_PREFIX=

# Port d'écoute du service. Par défaut : 5000 (sur Render, la plateforme
# fournit elle-même PORT).
# NE PAS déclarer cette variable si elle est vide : une valeur vide fait
# échouer le démarrage (ERR_SOCKET_BAD_PORT). Commentez-la plutôt.
# PORT=
