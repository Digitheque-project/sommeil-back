// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ConsultationLocale {
  id             String   @id @default(cuid())
  consultationId String   @unique // ID du service externe
  date           DateTime
  heure          String
  motif          String
  statut         String
  typeVisite     String
  urgence        Boolean  @default(false)
  arriveeAccueil Boolean  @default(false)
  estReport      Boolean  @default(false)
  // Doublon assumé de `statut === 'TERMINE'` : c'est le drapeau que consomme
  // l'interface (badge « Effectué », bouton d'archivage), et il doit rester
  // vrai même si le statut évolue vers une valeur plus fine plus tard.
  termine        Boolean  @default(false)
  patientId      String
  patientNom     String
  patientPrenom  String
  patientDossier String?
  medecinId      String?
  archived       Boolean  @default(false)
  // Rattachement d'un contrôle à la consultation qui l'a déclenché. Sans lui,
  // un contrôle créé à la finalisation ne pouvait pas être retrouvé et le
  // praticien retombait sur la liste au lieu de la fiche de contrôle.
  ordreControle         Int?
  consultationParenteId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  observations Observation[]
  compteRendus CompteRendu[]
}

model Observation {
  id                 String             @id @default(cuid())
  consultationId     String
  consultationLocale ConsultationLocale @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  diagnostic         String?
  // Le formulaire de traitement distingue l'hypothèse du diagnostic final :
  // les écraser dans le seul champ `diagnostic` perdait la suspicion.
  diagnosticSuspicion String?
  diagnosticRetenu    String?
  notes              String?
  // Paramètres cliniques ([{ nom, valeur, unite }]) et demandes non
  // médicamenteuses (contrôle, hospitalisation, recommandations) saisis dans
  // l'écran de traitement.
  parametres         Json?
  nonMedicaments     Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CompteRendu {
  id                 String                         @id @default(cuid())
  // Historique : les tout premiers comptes rendus étaient rattachés à une
  // consultation. Le flux courant les rattache à l'examen PSG terminé
  // (psgId) ; les deux champs restent optionnels pour ne pas casser les
  // enregistrements existants.
  consultationId     String?
  consultationLocale ConsultationLocale?            @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  psgId              String?
  psg                PolysomnographiePlanification? @relation(fields: [psgId], references: [id], onDelete: Cascade)
  titre              String
  contenu            String
  // Texte libre de conclusion, distinct du corps du compte rendu.
  conclusion         String?
  // URL de la photo importée (service-upload), servie telle quelle par l'export.
  photoUrl           String?
  type               String // 'MEDICAL', 'TECHNIQUE', etc.
  // 'BROUILLON' tant que le compte rendu est modifiable, 'VALIDE' une fois signé.
  statut             String                         @default("BROUILLON")
  valideLe           DateTime?
  validePar          String?
  patientId          String?
  patientNom         String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
}

model PolysomnographiePlanification {
  id             String    @id @default(cuid())
  prescriptionId String    @unique // ID du service externe
  patientId      String
  patientNom     String
  patientPrenom  String
  motif          String
  rdvDate        DateTime
  rdvHeure       String
  // Origine de la prescription (service prescriptions) : nécessaire pour
  // avertir le bon service/prescripteur quand le résultat est disponible.
  prescripteurId  String?
  serviceIdSource String?
  chuId           String?
  // 'PLANIFIE' -> 'EN_COURS' (psg:start) -> 'TERMINE' (psg:stop)
  statut         String    @default("PLANIFIE")
  urgence        Boolean   @default(false)
  demarreLe      DateTime?
  termineLe      DateTime?
  salle          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interpretation PsgInterpretation?
  compteRendus   CompteRendu[]
}

model PsgInterpretation {
  id            String                        @id @default(cuid())
  psgId         String                        @unique
  psg           PolysomnographiePlanification @relation(fields: [psgId], references: [id], onDelete: Cascade)
  patientId     String
  patientNom    String
  patientPrenom String
  titre         String
  // Texte libre rédigé par le médecin : pas de champs cliniques structurés imposés.
  contenu       String
  // 'BROUILLON' tant que modifiable, 'VALIDE' une fois signée.
  statut        String                        @default("BROUILLON")
  valideLe      DateTime?
  validePar     String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
}

model RendezVousPlanning {
  id             String   @id @default(cuid())
  // Rendez-vous né d'une prescription de polysomnographie. Sans ce lien, la
  // planification d'un examen n'apparaissait pas du tout au planning (deux
  // tables sans pont) ; il rend aussi l'écriture idempotente : replanifier
  // met à jour la ligne au lieu d'en créer une seconde.
  // Nullable et unique : les RDV saisis directement au planning n'en portent
  // pas, et PostgreSQL autorise autant de NULL que nécessaire.
  prescriptionId String?  @unique
  patientId      String
  patientNom     String
  patientPrenom  String
  patientDossier String?
  motif          String?
  priorite       String   @default("NORMALE") // TRES_URGENTE | URGENTE | NORMALE
  statut         String   @default("EN_ATTENTE") // EN_ATTENTE | REALISE | NON_REALISE | ANNULE
  dateRdv        DateTime
  heureDebut     String
  heureFin       String
  dureeMinutes   Int      @default(60)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Archive {
  id          String    @id @default(cuid())
  type        String // 'CONSULTATION', 'PRESCRIPTION', etc.
  referenceId String // ID de l'entité archivée
  titre       String
  description String?
  donnees     Json // Données sérialisées
  // Un dossier restauré reste tracé : il sort du registre sans être détruit.
  restored    Boolean   @default(false)
  restoredAt  DateTime?
  restoredBy  String?
  archivedAt  DateTime  @default(now())
  archivedBy  String? // ID de l'utilisateur
}
